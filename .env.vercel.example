# Copie os valores para Settings > Environment Variables na Vercel.
# Mantenha a mesma APP_KEY em todas as instâncias e em novos deployments.
APP_NAME="Laravel Task Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-projeto.vercel.app
APP_TIMEZONE=America/Maceio
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# Conexão fornecida pela integração PostgreSQL (não a publique no Git).
DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

LOG_CHANNEL=stderr
LOG_LEVEL=info
QUEUE_CONNECTION=sync
APP_MAINTENANCE_DRIVER=file
FILESYSTEM_DISK=local
MAIL_MAILER=log
TRUSTED_PROXIES=*
BOOST_ENABLED=false
BOOST_BROWSER_LOGS_WATCHER=false
